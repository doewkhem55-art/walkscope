# Copy to frontend/.env.local, then restart frontend (and rebuild dist if needed).
VITE_API_BASE_URL=http://127.0.0.1:8768
# Browser JavaScript API key, with matching Referer allowlist.
# Public browser key ONLY. Never put the server-side Baidu / DeepSeek key here.
VITE_BAIDU_MAP_AK=
VITE_DARK_MAP_MODE=filter
VITE_DARK_MAP_CUSTOM_CONFIRMED=false
