# Copy to .env. Values are not shell-expanded; fill secrets only on your own computer.
# Required only for a NEW live checkup. Server-side Baidu Web Service key.
BAIDU_MAP_AK=
# Optional: model report Q&A and web search. Never use VITE_ for these values.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_SEARCH=1
DEEPSEEK_THINKING=0
# Empty -> <this project>/data/reports via tools/dev.py.
CHECKUP_REPORT_DIR=
# Local frontend origins, no wildcard.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Limits cover the whole new live checkup; request time excludes a paused job.
CHECKUP_MAX_HTTP_REQUESTS=10000
CHECKUP_MAX_SECONDS=14400
CHECKUP_MAX_COVERAGE_ROUTE_PAIRS=50000
# Batch centre sampling and adaptive POI-distance requests.
BAIDU_ROUTING_BATCH_SIZE=25
BAIDU_HTTP_MIN_INTERVAL_S=1.5
# Centre isochrone sampling is separate from adaptive POI distance sampling.
# Final service boundaries are continuous 1000m contours, not 20m cell unions.
ISOCHRONE_ALGORITHM=grid
ISOCHRONE_GRID_CELL_M=100
ISOCHRONE_TIERS=1
# Historical stage replay is intentionally disabled. Do not enable casually.
CHECKUP_STAGE_MANIFEST=
CHECKUP_REPLAY_DIR=
CHECKUP_REPLAY_REPORTS=
